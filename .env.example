# Backend
# Directory for file-based storage (uploads, extracted pieces, debug images).
# Defaults to backend/uploads if unset.
UPLOADS_DIR=

# Frontend (only used when running `npm run dev` / `npm run preview` outside
# Docker — inside the container the frontend is served by the backend on
# the same port, so this isn't needed there).
VITE_API_URL=http://localhost:8000
